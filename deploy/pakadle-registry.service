# A container registry for one machine's own images.
#
# Bound to 127.0.0.1 on purpose: the only way in is the SSH tunnel that
# deploy/ship.sh opens, so there is no port to secure and nothing to
# authenticate against. Storage lives on the host so images survive a restart.
[Unit]
Description=Local container registry for Pakadle deploys
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=2

ExecStartPre=-/usr/bin/podman rm -f pakadle-registry
ExecStart=/usr/bin/podman run --rm --name pakadle-registry \
    --publish 127.0.0.1:5000:5000 \
    --volume /srv/pakadle/registry:/var/lib/registry:Z \
    --memory 96m --cpus 0.3 \
    docker.io/library/registry:2

ExecStop=/usr/bin/podman stop -t 10 pakadle-registry

[Install]
WantedBy=multi-user.target
